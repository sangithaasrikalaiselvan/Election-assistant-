{
  "name": "election-assistant-backend",
  "version": "1.0.0",
  "description": "Backend for the Election Assistant",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest --runInBand --coverage"
  },
  "dependencies": {
    "@google-cloud/dialogflow": "^7.5.0",
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "sanitize-html": "^2.13.0",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-security": "^1.7.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.8.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@google/generative-ai$": "<rootDir>/tests/mocks/generativeAi.js"
    },
    "collectCoverageFrom": [
      "services/**/*.js",
      "controllers/**/*.js",
      "routes/**/*.js",
      "utils/**/*.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
